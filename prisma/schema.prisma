generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  SOLO
  AGENCY
  STUDIO
}

enum Role {
  OWNER
  MEMBER
}

enum EntryStatus {
  DRAFT
  PUBLISHED
  DISMISSED
}

enum EntryCategory {
  NEW
  FIX
  IMPROVEMENT
}

model User {
  id          String       @id @default(cuid())
  githubId    String       @unique
  email       String?
  name        String?
  avatarUrl   String?
  createdAt   DateTime     @default(now())
  memberships OrgMember[]
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  plan                 Plan      @default(SOLO)
  billingEmail         String?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  createdAt            DateTime  @default(now())

  members  OrgMember[]
  projects Project[]
}

model OrgMember {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

// Bir GitHub App kurulumu; bir organizasyonun birden fazla kurulumu (farkli GitHub org'lari) olabilir.
model Installation {
  id                   String    @id @default(cuid())
  githubInstallationId BigInt    @unique
  githubAccountLogin   String
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  projects             Project[]

  @@index([organizationId])
}

// Bir GitHub reposuna karsilik gelen tek changelog projesi.
model Project {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installationId     String
  installation       Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  githubRepoFullName String       // ornek: "dixtuel/pixel-terzisi"
  name               String       // gorunen proje adi
  slug               String       @unique // public changelog url: /c/{slug}
  widgetKey          String       @unique @default(cuid()) // widget script bu anahtari kullanir

  brandName    String?
  brandColor   String?  @default("#3a6b52")
  brandLogoUrl String?
  customDomain String?  @unique
  hideBranding Boolean  @default(false) // Agency ve ustu planlarda acilabilir

  createdAt DateTime @default(now())

  entries        Entry[]
  webhookEvents  WebhookEvent[]

  @@index([organizationId])
}

model Entry {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category  EntryCategory
  title     String
  body      String

  status      EntryStatus @default(DRAFT)
  aiGenerated Boolean     @default(true)

  sourceCommitShas String[] @default([])
  sourcePrNumber   Int?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
}

// Idempotency ve hata ayiklama icin ham webhook kaydi.
model WebhookEvent {
  id                String   @id @default(cuid())
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  githubDeliveryId  String   @unique
  eventType         String
  payload           Json
  processedAt       DateTime?
  createdAt         DateTime @default(now())
}
