# Commit Günlüğü — Ortam Değişkenleri Şablonu (.env.example)
# Bu dosya genel şablondur, canlı gizli anahtarlar asla commit edilmez!
# Kopyalayıp yerel .env oluşturun: cp .env.example .env

HOST=127.0.0.1
PORT=8095
APP_BASE_URL=https://commit.dixtuel.tr

# Veritabanı (SQLite WAL Modu)
DATABASE_URL=sqlite://data/commit_gunlugu.db?mode=rwc

# GitHub Webhook HMAC-SHA256 Güvenlik Anahtarı (GitHub App oluştururken belirlediğiniz secret)
GITHUB_WEBHOOK_SECRET=commit_gunlugu_secret_key_change_me_in_prod

# GitHub Personal Access Token (PAT) veya GitHub App Token (GitHub Developer Program / API sorguları için)
GITHUB_TOKEN=

# 1. Aşama AI: NVIDIA NIM (İsteğe bağlı, boşsa deterministik kural motoru çalışır)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODELS=deepseek-ai/deepseek-v4-flash-0731,nvidia/nemotron-3.5-lightning-30b-a3b,google/gemma-4-31b-it

# DDoS & Hız Sınırlamaları (Leaky-Bucket)
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_MINUTE=30

# (İsteğe bağlı) Kullanıcıların özel GitHub PAT'lerini veritabanında
# AES-256-GCM ile şifrelemek için 64 hex karakterlik (32 byte) anahtar.
# Üretin: openssl rand -hex 32
# Boş bırakılırsa tokenlar düz metin olarak saklanır.
TOKEN_ENCRYPTION_KEY=

# (İsteğe bağlı) KVKK imha ledger'ını yedeklemek için KENDİ rclone remote'unuz
# (ör. "benim-r2-remote-adim:bucket-adi/commit-gunlugu"). Bu proje açık kaynak
# olduğu için hiçbir paylaşılan bulut kimlik bilgisi içermez — kendi rclone
# yapılandırmanızı (`rclone config`) oluşturup remote adını buraya yazın.
# Boş bırakılırsa ledger yalnızca yerel SQLite + data/erasure-ledger.jsonl'da tutulur.
R2_ERASURE_REMOTE=

# (İsteğe bağlı) Şifre sıfırlama e-postası göndermek için SMTP sunucunuz
# (kendi mail sunucunuz, SendGrid, Postmark, Mailgun vb. — herhangi bir düz
# SMTP uç noktası). SMTP_HOST boş bırakılırsa e-posta gönderimi tamamen
# atlanır ve sıfırlama bağlantısı yalnızca sunucu logunda görünür; bu proje
# açık kaynak olduğu için varsayılan bir mail sunucusu GÖMÜLMEZ.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=no-reply@localhost

# (İsteğe bağlı) KVKK / Gizlilik Sayfası Yasal Temsilci & İletişim Bilgileri
# Açık kaynak kod tabanında kişisel kimlik ifşa edilmez. Kendi dağıtımınızda
# yasal tüzel kişiliği / veri sorumlusunu ve iletişim e-postasını belirtebilirsiniz.
# Boş bırakılırsa jenerik yer tutucular kullanılır; istemci tarafında anti-bot koruması devrededir.
LEGAL_ENTITY_NAME=Proje Yöneticisi
PRIVACY_CONTACT_EMAIL=contact@example.com

